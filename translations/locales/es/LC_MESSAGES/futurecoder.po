msgid "pages.Types.steps.format_board_with_numbers.hints.3.text"
msgstr "Queremos números en la primera línea así: 1, 2, 3, ..."

msgid "pages.Types.steps.format_board_with_numbers.hints.4.text"
msgstr ""
