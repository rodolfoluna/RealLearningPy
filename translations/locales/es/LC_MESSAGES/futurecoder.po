msgstr "Necesitarás un bucle."

msgid "pages.UsingBreak.steps.list_contains_exercise.hints.1.text"
msgstr "Necesitarás una sentencia `if`."

msgid "pages.UsingBreak.steps.list_contains_exercise.hints.2.text"
